LLM_PROVIDER=mock            # mock | gemini | openai
LLM_MODEL=                   # set to a current model name for your provider (reasoning, code, review)
LLM_MODEL_FAST=              # optional cheaper model for planning / tool choice / reflection (default: LLM_MODEL)
# LLM_FALLBACK=gemini:model  # optional backup "provider[:model]" tried when the primary keeps failing (needs that provider's key)
# LLM_TEMPERATURE=0.1  LLM_MAX_TOKENS=4096  LLM_TIMEOUT=60  LLM_MAX_RETRIES=3  MAX_LLM_CALLS=40
# LLM_PRICES={"your-model": [0.15, 0.60]}   # optional USD per 1M input/output tokens -> cost in /llm/usage (nothing is hard-coded)
# --- optional web search tool (the model can search the internet for error messages; off unless a key is set; queries are scrubbed of paths/emails/secrets) ---
# WEB_SEARCH_PROVIDER=brave   # brave | tavily (default: whichever key below is set)
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# MAX_TEST_RUNS=4            # test runs the model may start itself per task
# MAX_TOOL_CALLS=10  MAX_TOOL_ITERATIONS=5  MAX_AGENT_TOTAL_STEPS=40  HISTORY_TURNS=4  HISTORY_TOKEN_BUDGET=900
# MAX_RUN_SECONDS=900        # wall-clock limit for one agent run (0 = none); the run stops at the next step and reports an error
EMBEDDING_PROVIDER=hash      # hash | openai | gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
ALLOW_LOCAL_PATHS=false
MAX_AGENT_STEPS=3
MAX_FIX_ATTEMPTS=2
TEST_TIMEOUT=120
GITHUB_TOKEN=               # optional: lets the agent open pull requests (needs repo scope)

# --- Sign in with GitHub (optional): browse and import your private repositories ---------------------------------
# Create an OAuth App at https://github.com/settings/developers  ->  callback URL: http://localhost:8000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_SCOPE=repo read:user   # use "public_repo read:user" if you only need public repositories
OAUTH_REDIRECT_BASE=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# --- Private GitLab / Bitbucket repositories (sign-in for these is planned) ---------------------------------------
GITLAB_TOKEN=
BITBUCKET_USERNAME=
BITBUCKET_APP_PASSWORD=

# --- RAG pipeline ---------------------------------------------------------------------------------------------------
# DATABASE_URL=postgresql://agent:agent@localhost:5432/codeagent   # set to store chunks + vectors in PostgreSQL/pgvector (docker compose up db)
# DATABASE_SCHEMA=                                                  # optional: keep the tables in their own schema
# RAG_STORE=auto                    # auto (pgvector when DATABASE_URL is set) | memory | pgvector
# Embeddings: hash (offline baseline) | openai | gemini | bge | fastembed
# EMBEDDING_PROVIDER=openai         EMBEDDING_MODEL=text-embedding-3-small    EMBEDDING_DIM=1536
# EMBEDDING_PROVIDER=gemini         EMBEDDING_MODEL=gemini-embedding-001      EMBEDDING_DIM=768
# EMBEDDING_PROVIDER=bge            EMBEDDING_MODEL=BAAI/bge-small-en-v1.5     # pip install sentence-transformers
# OPENAI_BASE_URL=https://api.openai.com/v1   # or any OpenAI-compatible server (Ollama, vLLM, TEI) serving a local embedding model
# RERANKER=heuristic                # none | heuristic | bge-reranker-base | cross-encoder:<model> | llm
# RETRIEVAL_MODE=hybrid             # hybrid | vector | keyword
# RRF_K=60   VECTOR_WEIGHT=         KEYWORD_WEIGHT=1.0   RETRIEVAL_CANDIDATES=50   CONTEXT_TOKEN_BUDGET=6000
# (VECTOR_WEIGHT unset = 0.25 for the hash baseline, 1.0 for real models; tune with `python -m app.rag.eval`)

# --- code execution sandbox (see docs/SANDBOX.md) ---
# SANDBOX_MODE=docker          # docker (default, isolated) | local (runs repository code ON THIS MACHINE: development only)
# SANDBOX_CPUS=1.0  SANDBOX_MEMORY_MB=1024  SANDBOX_PIDS=256  SANDBOX_TMPFS_MB=256  SANDBOX_OUTPUT_LIMIT=1000000
# SANDBOX_NETWORK=none         # none (default) | bridge
# SANDBOX_IMAGE_PYTHON=codebase-agent/sandbox-python:latest   (also _NODE _GO _RUST _JAVA; build with scripts/build_sandbox.sh)
# SANDBOX_INSTALL_DEPS=false   # separate networked install step (no install scripts run)
# SANDBOX_AUDIT_NETWORK=false  # allow pip-audit / npm audit to reach their advisory databases
# SANDBOX_MAX_CONCURRENT=2  SANDBOX_QUEUE_TIMEOUT=120   # containers at once, server-wide; waiting time before a run is refused as busy
# RATE_LIMIT_PER_MINUTE=0      # per-client limit on endpoints that start agents or run code (0 = off; ~30 for a public service)
